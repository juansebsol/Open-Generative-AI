{
  "name": "openstudio",
  "description": "Open-source, bring-your-own-key AI image, video, audio and lip sync studio. Works with fal.ai, WaveSpeed, OpenRouter, Google Gemini, OpenAI and local ComfyUI.",
  "homepage": "https://github.com/juansebsol/Open-Generative-AI",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/studio"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint app components lib middleware.js packages/studio/src/providers packages/studio/src/generation.js packages/studio/src/studioAvailability.js packages/studio/src/benchmarks.js packages/studio/src/benchmarksHelper.js scripts",
    "test": "node --test 'tests/**/*.test.mjs'",
    "routes:sync": "node scripts/sync-provider-schemas.mjs",
    "routes:validate": "node scripts/validate-routes.mjs",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.31.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    }
  }
}
